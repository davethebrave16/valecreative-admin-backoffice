# GitHub repository target for the repository_dispatch trigger
GITHUB_OWNER=valecreative
GITHUB_REPO=valecreative-site

# GITHUB_DISPATCH_TOKEN is NOT stored here — it's a Firebase Secret.
# Set it with: firebase functions:secrets:set GITHUB_DISPATCH_TOKEN
# Requires a GitHub PAT with the `repo` scope.

# Brevo transactional email configuration (submitCommission notifications)
EMAIL_SENDER_ADDRESS=noreply@site.it
OWNER_NOTIFICATION_EMAIL=valentina@example.com
BACKOFFICE_BASE_URL=https://backoffice-url

# BREVO_API_KEY is NOT stored here — it's a Firebase Secret.
# Set it with: firebase functions:secrets:set BREVO_API_KEY
# Requires a Brevo API key with transactional-email send permission.
